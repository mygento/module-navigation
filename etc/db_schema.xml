<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="mygento_navigation_menu" resource="default" engine="innodb" comment="Menu Table">
        <column xsi:type="int" name="entity_id" nullable="false" identity="true" unsigned="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="code" nullable="false" length="255" comment="Code"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
    <table name="mygento_navigation_item" resource="default" engine="innodb" comment="Item Table">
        <column xsi:type="int" name="entity_id" nullable="false" identity="true" unsigned="true" comment="Entity ID"/>
        <column xsi:type="int" name="menu" nullable="true" identity="false" unsigned="true" comment="Menu ID"/>
        <column xsi:type="boolean" name="is_active" nullable="false" comment="Is_active"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="varchar" name="entity_type" nullable="false" length="50" default="0" comment="Link Type"/>
        <column xsi:type="varchar" name="entity_slug" nullable="true" length="255" comment="Link Identifier"/>
        <column xsi:type="varchar" name="image" nullable="true" length="255" comment="Image"/>
        <column xsi:type="smallint" name="sort_order" nullable="false" identity="false" unsigned="true" default="0" comment="Link Sort Order"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
    <table name="mygento_navigation_item_store" resource="default" engine="innodb" comment="Item Table With Store">
        <column xsi:type="int" name="entity_id" nullable="false" identity="false" unsigned="true" comment="Entity ID"/>
        <column xsi:type="smallint" name="store_id" nullable="false" identity="false" unsigned="true" comment="Store ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
            <column name="store_id"/>
        </constraint>
        <index referenceId="IX_ITEM_STORE_ID" indexType="btree">
            <column name="store_id"/>
        </index>
        <constraint xsi:type="foreign" referenceId="FK_ITEM_STORE_ID" table="mygento_navigation_item_store" column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="FK_ITEM_ENT_ID" table="mygento_navigation_item_store" column="entity_id" referenceTable="mygento_navigation_item" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index indexType="btree" referenceId="IX_ENT_ID">
            <column name="entity_id"/>
        </index>
    </table>
</schema>
