<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">navigation_item_edit.navigation_item_edit_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">General Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save_and_continue" class="Mygento\Base\Block\Adminhtml\Component\Edit\SaveAndContinueButton"/>
            <button name="save" class="Mygento\Base\Block\Adminhtml\Component\Edit\SaveButton"/>
            <button name="reset" class="Mygento\Base\Block\Adminhtml\Component\Edit\ResetButton"/>
            <button name="delete" class="Mygento\Base\Block\Adminhtml\Component\Edit\DeleteButton"/>
            <button name="back" class="Mygento\Base\Block\Adminhtml\Component\Edit\BackButton"/>
        </buttons>
        <namespace>navigation_item_edit</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>navigation_item_edit.navigation_item_edit_data_source</dep>
        </deps>
    </settings>
    <dataSource name="navigation_item_edit_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="navigation/item/save"/>
        </settings>
        <dataProvider name="navigation_item_edit_data_source" class="Mygento\Navigation\Model\Item\DataProvider">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label></label>
        </settings>
        <field name="entity_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">item</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Entity Id</label>
                <visible>false</visible>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>
        <field name="menu" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">item</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Menu</label>
                <visible>true</visible>
                <dataScope>menu</dataScope>
                <validation>
                    <rule name="validate-integer" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Mygento\Navigation\Model\Source\Menu"/>
                        <caption translate="true">-- Please Select --</caption>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="is_active" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">item</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Is Active</label>
                <visible>true</visible>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="name" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">item</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <visible>true</visible>
                <dataScope>name</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="image" formElement="imageUploader">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">item</item>
                </item>
            </argument>
            <settings>
                <elementTmpl>ui/form/element/uploader/image</elementTmpl>
                <dataType>string</dataType>
                <label translate="true">Image</label>
                <visible>true</visible>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <required>true</required>
                        <uploaderConfig>
                            <param xsi:type="url" name="url" path="navigation/item/upload"/>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                        <openDialogTitle>Media Gallery</openDialogTitle>
                        <initialMediaGalleryOpenSubpath>navigation/item</initialMediaGalleryOpenSubpath>
                        <allowedExtensions>jpg jpeg png</allowedExtensions>
                        <maxFileSize>4194304</maxFileSize>
                        <isMultipleFiles>false</isMultipleFiles>
                    </settings>
                </imageUploader>
            </formElements>
        </field>

        <field name="entity_type" formElement="select" component="Mygento_Navigation/js/form/element/entity-type">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">item</item>
                    <item name="default" xsi:type="string">catalog_category</item>
                    <item name="clearTargets" xsi:type="array">
                        <item name="0" xsi:type="string">navigation_item_edit.navigation_item_edit.general.entity_identifier</item>
                        <item name="1" xsi:type="string">navigation_item_edit.navigation_item_edit.general.entity_label</item>
                        <item name="2" xsi:type="string">navigation_item_edit.navigation_item_edit.general.catalog_category_entity</item>
                    </item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Entity Type</label>
                <visible>true</visible>
                <dataScope>entity_type</dataScope>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value></value>
                            <actions>
                                <action name="0">
                                    <target>navigation_item_edit.navigation_item_edit.general.assign_cms_page_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="1">
                                    <target>navigation_item_edit.navigation_item_edit.general.assign_cms_block_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="2">
                                    <target>navigation_item_edit.navigation_item_edit.general.catalog_category_entity</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="3">
                                    <target>navigation_item_edit.navigation_item_edit.general.catalog_product_entity_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="4">
                                    <target>navigation_item_edit.navigation_item_edit.general.entity_identifier</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>custom</value>
                            <actions>
                                <action name="0">
                                    <target>navigation_item_edit.navigation_item_edit.general.assign_cms_page_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="1">
                                    <target>navigation_item_edit.navigation_item_edit.general.assign_cms_block_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="2">
                                    <target>navigation_item_edit.navigation_item_edit.general.catalog_category_entity</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="3">
                                    <target>navigation_item_edit.navigation_item_edit.general.catalog_product_entity_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="4">
                                    <target>navigation_item_edit.navigation_item_edit.general.entity_identifier</target>
                                    <callback>show</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="2">
                            <value>cms_page</value>
                            <actions>
                                <action name="0">
                                    <target>navigation_item_edit.navigation_item_edit.general.assign_cms_page_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">true</param>
                                    </params>
                                </action>
                                <action name="1">
                                    <target>navigation_item_edit.navigation_item_edit.general.assign_cms_block_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="2">
                                    <target>navigation_item_edit.navigation_item_edit.general.catalog_category_entity</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="3">
                                    <target>navigation_item_edit.navigation_item_edit.general.catalog_product_entity_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="4">
                                    <target>navigation_item_edit.navigation_item_edit.general.entity_identifier</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="3">
                            <value>cms_block</value>
                            <actions>
                                <action name="0">
                                    <target>navigation_item_edit.navigation_item_edit.general.assign_cms_page_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="1">
                                    <target>navigation_item_edit.navigation_item_edit.general.assign_cms_block_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">true</param>
                                    </params>
                                </action>
                                <action name="2">
                                    <target>navigation_item_edit.navigation_item_edit.general.catalog_category_entity</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="3">
                                    <target>navigation_item_edit.navigation_item_edit.general.catalog_product_entity_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="4">
                                    <target>navigation_item_edit.navigation_item_edit.general.entity_identifier</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="4">
                            <value>catalog_category</value>
                            <actions>
                                <action name="0">
                                    <target>navigation_item_edit.navigation_item_edit.general.assign_cms_page_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="1">
                                    <target>navigation_item_edit.navigation_item_edit.general.assign_cms_block_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="2">
                                    <target>navigation_item_edit.navigation_item_edit.general.catalog_category_entity</target>
                                    <callback>show</callback>
                                </action>
                                <action name="3">
                                    <target>navigation_item_edit.navigation_item_edit.general.catalog_product_entity_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="4">
                                    <target>navigation_item_edit.navigation_item_edit.general.entity_identifier</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="5">
                            <value>catalog_product</value>
                            <actions>
                                <action name="0">
                                    <target>navigation_item_edit.navigation_item_edit.general.assign_cms_page_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="1">
                                    <target>navigation_item_edit.navigation_item_edit.general.assign_cms_block_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                                <action name="2">
                                    <target>navigation_item_edit.navigation_item_edit.general.catalog_category_entity</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="3">
                                    <target>navigation_item_edit.navigation_item_edit.general.catalog_product_entity_container</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">true</param>
                                    </params>
                                </action>
                                <action name="4">
                                    <target>navigation_item_edit.navigation_item_edit.general.entity_identifier</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Mygento\Navigation\Model\Source\EntityType"/>
                        <caption translate="true">-- Please Select --</caption>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="entity_identifier" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">item</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Identifier</label>
                <visible>false</visible>
                <dataScope>entity_identifier</dataScope>
            </settings>
        </field>
        <field name="entity_label" formElement="input" component="Mygento_Navigation/js/form/element/selected-label">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Selected</label>
                <visible>false</visible>
                <disabled>true</disabled>
                <dataScope>entity_label</dataScope>
            </settings>
        </field>
        <field name="catalog_category_entity" component="Magento_Catalog/js/components/new-category" sortOrder="30" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                    <item name="showCheckbox" xsi:type="boolean">false</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="levelsVisibility" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <elementTmpl>ui/grid/filters/elements/ui-select</elementTmpl>
                <label translate="true">Category</label>
                <dataScope>entity_identifier</dataScope>
                <componentType>field</componentType>
                <visible>false</visible>
                <listens>
                    <link name="${ $.namespace }.${ $.namespace }:responseData">setParsed</link>
                </listens>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Catalog\Ui\Component\Product\Form\Categories\Options"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <container name="catalog_product_entity_container" component="Magento_Ui/js/form/components/group" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="formElement" xsi:type="string">container</item>
                    <item name="breakLine" xsi:type="boolean">false</item>
                    <item name="dataScope" xsi:type="string" />
                    <item name="label" xsi:type="string" />
                </item>
            </argument>
            <button name="assign_catalog_product_button" template="ui/form/components/button/container">
                <settings>
                    <title translate="true">Assign Catalog Product</title>
                    <dataScope />
                </settings>
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="formElement" xsi:type="string">container</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="array">
                                <item name="targetName" xsi:type="string">navigation_item_edit.navigation_item_edit.general.assign_catalog_product</item>
                                <item name="actionName" xsi:type="string">toggleModal</item>
                            </item>
                        </item>
                        <item name="additionalForGroup" xsi:type="boolean">true</item>
                        <item name="additionalClasses" xsi:type="string">admin__field-medium</item>
                    </item>
                </argument>
            </button>
        </container>
        <container name="assign_cms_page_container" component="Magento_Ui/js/form/components/group" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="formElement" xsi:type="string">container</item>
                    <item name="breakLine" xsi:type="boolean">false</item>
                    <item name="dataScope" xsi:type="string" />
                    <item name="label" xsi:type="string" />
                </item>
            </argument>
            <button name="assign_cms_page_button" template="ui/form/components/button/container">
                <settings>
                    <title translate="true">Assign CMS Page</title>
                    <dataScope />
                </settings>
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="formElement" xsi:type="string">container</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="array">
                                <item name="targetName" xsi:type="string">navigation_item_edit.navigation_item_edit.general.assign_cms_page</item>
                                <item name="actionName" xsi:type="string">toggleModal</item>
                            </item>
                        </item>
                        <item name="additionalForGroup" xsi:type="boolean">true</item>
                        <item name="additionalClasses" xsi:type="string">admin__field-medium</item>
                    </item>
                </argument>
            </button>
        </container>
        <container name="assign_cms_block_container" component="Magento_Ui/js/form/components/group" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="formElement" xsi:type="string">container</item>
                    <item name="breakLine" xsi:type="boolean">false</item>
                    <item name="dataScope" xsi:type="string" />
                    <item name="label" xsi:type="string" />
                </item>
            </argument>
            <button name="assign_cms_block_button" template="ui/form/components/button/container">
                <settings>
                    <title translate="true">Assign CMS Block</title>
                    <dataScope />
                </settings>
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="formElement" xsi:type="string">container</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="array">
                                <item name="targetName" xsi:type="string">navigation_item_edit.navigation_item_edit.general.assign_cms_block</item>
                                <item name="actionName" xsi:type="string">toggleModal</item>
                            </item>
                        </item>
                        <item name="additionalForGroup" xsi:type="boolean">true</item>
                        <item name="additionalClasses" xsi:type="string">admin__field-medium</item>
                    </item>
                </argument>
            </button>
        </container>
        <field name="sort_order" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">item</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Sort Order</label>
                <visible>true</visible>
                <dataScope>sort_order</dataScope>
                <validation>
                    <rule name="validate-integer" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="store_id" formElement="multiselect" class="Magento\Store\Ui\Component\Form\Field\StoreView">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">item</item>
                </item>
            </argument>
            <settings>
                <dataType>int</dataType>
                <label translate="true">Store Id</label>
                <visible>true</visible>
                <dataScope>store_id</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Magento\Store\Ui\Component\Listing\Column\Store\Options"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <modal name="assign_cms_page">
            <settings>
                <listens>
                    <link name="navigation_page_select_grid.navigation_page_select_grid.columns.ids:lastSelected">closeModal</link>
                </listens>
                <options>
                    <option name="title" xsi:type="string" translate="true">Select Page</option>
                </options>
            </settings>
            <insertListing name="navigation_page_select_grid" sortOrder="10">
                <settings>
                    <externalData>page_id</externalData>
                    <externalProvider>${ $.ns }.navigation_page_select_grid_data_source</externalProvider>
                    <loading>false</loading>
                    <selectionsProvider>${ $.ns }.${ $.ns }.columns.ids</selectionsProvider>
                    <autoRender>true</autoRender>
                    <dataScope>entity_identifier</dataScope>
                    <ns>navigation_page_select_grid</ns>
                    <dataLinks>
                        <imports>false</imports>
                        <exports>true</exports>
                    </dataLinks>
                    <listens>
                        <link name="navigation_page_select_grid.navigation_page_select_grid.columns.ids:lastSelected">save</link>
                    </listens>
                </settings>
            </insertListing>
        </modal>
        <modal name="assign_cms_block">
            <settings>
                <listens>
                    <link name="navigation_block_select_grid.navigation_block_select_grid.columns.ids:lastSelected">closeModal</link>
                </listens>
                <options>
                    <option name="title" xsi:type="string" translate="true">Select Block</option>
                </options>
            </settings>
            <insertListing name="navigation_block_select_grid" sortOrder="10">
                <settings>
                    <externalData>block_id</externalData>
                    <externalProvider>${ $.ns }.navigation_block_select_grid_data_source</externalProvider>
                    <loading>false</loading>
                    <selectionsProvider>${ $.ns }.${ $.ns }.columns.ids</selectionsProvider>
                    <autoRender>true</autoRender>
                    <dataScope>entity_identifier</dataScope>
                    <ns>navigation_block_select_grid</ns>
                    <dataLinks>
                        <imports>false</imports>
                        <exports>true</exports>
                    </dataLinks>
                    <listens>
